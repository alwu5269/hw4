# Copy this file to .env (in this hw4 folder) and fill in real values.
# Never commit .env.

# Portkey API key used by the chat agent (model: gpt-5.6-luna via https://api.portkey.ai/v1)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: secret used to sign login sessions and guest chat history.
# Any long random string; if unset, a random one is made at startup (everyone is logged out on restart).
AUTH_SECRET=replace-with-a-long-random-string
